{
  "name": "fishora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "postinstall": "prisma generate",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "^15.5.28",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "dotenv": "^18.0.8",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
